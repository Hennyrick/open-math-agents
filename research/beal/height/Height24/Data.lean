import Bounded

namespace BealHeight.TwoTo24

def checkRow (xs : List (Nat × Nat)) (a : Nat × Nat) : Bool :=
  xs.all fun b =>
    ((byValue xs).getD (a.2+b.2) []).all fun c => decide (1 < Nat.gcd a.1 (Nat.gcd b.1 c))

/-- Transport the finite check before substituting the concrete list. -/
theorem from_checked_rows (bound : Nat) (xs : List (Nat × Nat)) (h : powers bound = xs)
    (good : xs.all (checkRow xs) = true) : HoldsUpTo bound := by
  apply (certifies_iff bound).mp
  change (powers bound).all (checkRow (powers bound)) = true
  rw [h]
  exact good

theorem all_append_of_all {α : Type} {f : α → Bool} {xs ys : List α}
    (hx : xs.all f = true) (hy : ys.all f = true) : (xs ++ ys).all f = true := by
  rw [List.all_append, hx, hy]
  rfl

